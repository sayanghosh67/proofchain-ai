# Local single-user demo. Bind the web app and worker to loopback only.
APP_MODE=local
GEMINI_API_KEY=
# Choose a model enabled for your account; no default model is assumed.
GEMINI_MODEL=
# Supabase mode requires APP_MODE=supabase and the migration below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_TOKEN=
TEST_WORKER_URL=http://127.0.0.1:4319
# npm run demo generates an ephemeral shared secret automatically.
TEST_WORKER_SECRET=
# Comma-separated exact HTTPS hosts permitted for active GET checks. Empty = disabled.
PUBLIC_CHECK_HOSTS=
